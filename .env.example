# Copy this file to .env and fill in local values. Never commit .env.
PORT=5000
MONGO_URI=
JWT_SECRET=

# Gmail SMTP. Use a Google App Password, not your Google account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional separate HMAC key for password reset OTP storage.
PASSWORD_RESET_SECRET=

# Optional one-time initial administrator bootstrap (never use a real password here).
# Set these only in the server environment, run `node utils/createAdmin.js` once, then remove them.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_ADMIN_PASSWORD=
