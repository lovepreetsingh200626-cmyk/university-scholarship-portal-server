# Copy this file to .env and fill in local values. Never commit .env.
PORT=5000
MONGO_URI=
JWT_SECRET=

# Gmail SMTP. Use a Google App Password, not your Google account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional separate HMAC key for password reset OTP storage.
PASSWORD_RESET_SECRET=
